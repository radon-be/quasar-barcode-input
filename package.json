{
  "name": "@radon-be/quasar-app-extension-barcode-input",
  "version": "0.0.1",
  "description": "Quasar App Extension and library for barcode capture and search input",
  "keywords": [
    "app-extension",
    "barcode",
    "barcode-scanner",
    "quasar",
    "search-input",
    "vue"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/components.js",
  "types": "./dist/components.d.ts",
  "exports": {
    ".": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "lint": "oxfmt && oxlint --fix",
    "lint:check": "oxfmt --check && oxlint",
    "build": "vite build && vue-tsc --project tsconfig.build.json",
    "watch": "tsc --watch",
    "typecheck": "vue-tsc --noEmit",
    "pack:local": "npm run build && npm pack --pack-destination playground-for-package"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.1",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vueuse/core": "^12.0.0",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.8",
    "quasar": "^2.34.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vue": "^3.5.22",
    "vue-tsc": "^3.3.3"
  },
  "peerDependencies": {
    "@vueuse/core": ">=12",
    "quasar": "^2",
    "vue": "^3.5"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "quasar": {
    "appExtension": {
      "id": "barcode-input",
      "shortName": "Barcode Input",
      "vueVersion": "3"
    }
  }
}
